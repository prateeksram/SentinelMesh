# Qualcomm Cloud AI100 configuration for post-match report artwork.
AI100_BASE_URL=https://aisuite.cirrascale.com/apis/v2
AI100_API_KEY=YOUR_QUALCOMM_KEY
AI100_MODEL=stabilityai/sdxl-turbo
AI100_IMAGE_SIZE=512x512
AI100_TIMEOUT_SECONDS=240

# Optional public origin for report QR codes (for example an ngrok URL).
# On a shared LAN, the server automatically uses the laptop's LAN address.
GF_PUBLIC_BASE_URL=

# Allow /api/report/simulate from non-local clients. Leave off for normal use.
GF_ENABLE_REPORT_SIM=0
