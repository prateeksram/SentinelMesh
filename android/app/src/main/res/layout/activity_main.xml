<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fitsSystemWindows="true">

    <!-- Full-bleed camera -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:implementationMode="compatible"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Same full-bleed visual surface, enabled only for the optional UNO Q source. -->
    <com.sentinelmesh.gesturefootball.ui.RemoteCameraView
        android:id="@+id/edgePreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.sentinelmesh.gesturefootball.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <!-- Thin top bar -->
    <TextView
        android:id="@+id/brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/brand"
        android:textColor="@color/qcom"
        android:textStyle="bold"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/recBtn"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/recBtn"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:paddingHorizontal="10dp"
        android:gravity="center"
        android:background="@drawable/pill_surface"
        android:text="@string/rec_btn"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintTop_toTopOf="@id/brand"
        app:layout_constraintBottom_toBottomOf="@id/brand"
        app:layout_constraintEnd_toStartOf="@id/calibBtn" />

    <TextView
        android:id="@+id/calibBtn"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:paddingHorizontal="10dp"
        android:gravity="center"
        android:background="@drawable/pill_surface"
        android:text="@string/calib_btn"
        android:textColor="@color/cyan"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintTop_toTopOf="@id/brand"
        app:layout_constraintBottom_toBottomOf="@id/brand"
        app:layout_constraintEnd_toStartOf="@id/hostPill" />

    <TextView
        android:id="@+id/hostPill"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/host_pill_offline"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:text="Offline"
        android:textColor="@color/muted"
        android:textStyle="bold"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/brand"
        app:layout_constraintBottom_toBottomOf="@id/brand"
        app:layout_constrainedWidth="true" />

    <!-- Hidden LED kept for binding compatibility. -->
    <View
        android:id="@+id/led"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Expandable host connect row -->
    <LinearLayout
        android:id="@+id/hostRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_surface"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/brand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/hostUrl"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/zone_off"
            android:paddingHorizontal="10dp"
            android:hint="laptop-ip:8080"
            android:inputType="textUri"
            android:textColor="@color/chalk"
            android:textColorHint="@color/muted"
            android:textSize="12sp"
            android:singleLine="true"
            android:imeOptions="actionDone" />

        <TextView
            android:id="@+id/hostConnect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="14dp"
            android:gravity="center"
            android:background="@drawable/zone_on"
            android:text="HOST"
            android:textColor="@color/chalk"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Phase copy overlay (centered on camera) -->
    <LinearLayout
        android:id="@+id/phaseCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/scrim_phase"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.28">

        <TextView
            android:id="@+id/big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/chalk"
            android:textStyle="bold"
            android:textSize="28sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/hint_default"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/lobbyReadyBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/zone_on"
            android:gravity="center"
            android:text="@string/lobby_ready"
            android:textColor="@color/chalk"
            android:textStyle="bold"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Compact AI chip (long-press expands telemetry) -->
    <TextView
        android:id="@+id/aiChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/pill_surface"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="AI · —"
        android:textColor="@color/chalk"
        android:textStyle="bold"
        android:textSize="11sp"
        android:fontFamily="monospace"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/zones" />

    <TextView
        android:id="@+id/forceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/pill_surface"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:text="0 N"
        android:textColor="@color/cyan"
        android:textStyle="bold"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/aiChip"
        app:layout_constraintTop_toTopOf="@id/aiChip"
        app:layout_constraintBottom_toBottomOf="@id/aiChip" />

    <TextView
        android:id="@+id/bodyBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/pill_surface"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:text="NO BODY"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/aiChip"
        app:layout_constraintBottom_toBottomOf="@id/aiChip" />

    <!-- Kept for binding; mirrored into aiChip. -->
    <TextView
        android:id="@+id/aiBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="BODY AI · ON-DEVICE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/voiceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="VOICE · OFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Floating aim chips -->
    <LinearLayout
        android:id="@+id/zones"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toTopOf="@id/calibration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/zL" style="@style/ZoneChip" android:text="L" />
        <TextView
            android:id="@+id/zC"
            style="@style/ZoneChip"
            android:text="C"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/zR" style="@style/ZoneChip" android:text="R" />
    </LinearLayout>

    <!-- Calibration bottom sheet -->
    <include
        android:id="@+id/calibration"
        layout="@layout/include_calibration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/telemetry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Expandable ON-DEVICE AI telemetry (hidden by default) -->
    <LinearLayout
        android:id="@+id/telemetry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        android:background="@drawable/card_surface"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ON-DEVICE AI"
            android:textColor="@color/muted"
            android:textStyle="bold"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POSE"
                    android:textColor="@color/muted"
                    android:textStyle="bold"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/npuBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPU · —"
                    android:textColor="@color/chalk"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOICE"
                    android:textColor="@color/muted"
                    android:textStyle="bold"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/asrStat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/chalk"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COACH"
                    android:textColor="@color/muted"
                    android:textStyle="bold"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/llmStat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/chalk"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FORCE"
                    android:textColor="@color/muted"
                    android:textStyle="bold"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/forceStat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 N"
                    android:textColor="@color/cyan"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/neuralLoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingTop="10dp"
            android:text=""
            android:textColor="@color/muted"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Cold-start QPlay splash + sport picker (topmost) -->
    <FrameLayout
        android:id="@+id/onboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/ink"
        android:clickable="true"
        android:focusable="true"
        android:elevation="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/splashPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/splashMark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Q"
                android:textColor="@color/qcom"
                android:textSize="96sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:shadowColor="#AA3253DC"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="36" />

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/splash_title"
                android:textColor="@color/chalk"
                android:textSize="48sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:shadowColor="#803253DC"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="18" />

            <TextView
                android:id="@+id/splashTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/splash_tag"
                android:textColor="@color/cyan"
                android:textSize="14sp"
                android:letterSpacing="0.22" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sportPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_sport"
                android:textColor="@color/chalk"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:text="@string/choose_sport_hint"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/sportFootball"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/zone_on"
                android:gravity="center"
                android:text="@string/sport_football"
                android:textColor="@color/chalk"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/sportDarts"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/zone_on"
                android:gravity="center"
                android:text="@string/sport_darts"
                android:textColor="@color/chalk"
                android:textStyle="bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/sportBasketball"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/zone_on"
                android:gravity="center"
                android:text="@string/sport_basketball"
                android:textColor="@color/chalk"
                android:textStyle="bold"
                android:textSize="17sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
